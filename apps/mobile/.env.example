# Copy to .env and replace the example endpoints with your deployment URLs.
# Restart Metro after changes: npm start -- --reset-cache
MIMOTO_HOST=https://mimoto.example.org
ESIGNET_HOST=https://esignet.example.org
OBSRV_HOST=https://telemetry.example.org

# Supported themes: gradient | purple
APPLICATION_THEME=gradient
CREDENTIAL_REGISTRY_EDIT=true
DEBUG_MODE=false
LIVENESS_DETECTION=false

# Supported languages: en, fil, ar, hi, kn, ta
APPLICATION_LANGUAGE=en

# Supply your application's OAuth client ID when enabling Google backup.
GOOGLE_ANDROID_CLIENT_ID=<client_id>
