# AIT Wallet BFF —  Environment Configuration
BFF_PORT=8099
# Phase 1: Official Mimoto Docker Image
MIMOTO_IMAGE=injistack/mimoto:0.22.0

# AIT Authoritative Issuer & IdP Endpoints (used by Phase 2 Node.js BFF & Issuer configs)
AIT_ISSUER_BASE_URL=https://issuer.ait.ac.th
AIT_IDP_BASE_URL=https://sso.ait.ac.th

# Local dev Postgres (NOT production secrets)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PKCS#12 keystore password — MUST match the keystore scripts/generate-keystore.sh makes
# OIDC_P12_PASSWORD in your shell: the Bash generator does not read .env itself.
# Keep the password unchanged for an existing keystore.
OIDC_P12_PASSWORD=dummypassword



